              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/members/{memberId}/bindings": {
      "get": {
        "operationId": "listMemberBindings",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BindingList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MemberID"
            }
          }
        ]
      },
      "post": {
        "operationId": "bindMemberFactor",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Binding"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MemberID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BindFactor"
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/members/{memberId}/bindings/{factorId}": {
      "delete": {
        "operationId": "revokeMemberBinding",
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MemberID"
            }
          },
          {
            "name": "factorId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FactorID"
            }
          }
        ]
      }
    },
    "/v1/factors/{factorId}": {
      "get": {
        "operationId": "getFactor",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Factor"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "factorId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FactorID"
            }
          }
        ]
      }
    },
    "/v1/eligibility": {
      "post": {
        "operationId": "checkMemberEligibility",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Eligibility"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EligibilityRequest"
              }
            }
          }
        }
      }
    },
    "/v1/organization-enrollments": {
      "post": {
        "operationId": "enrollOrganization",
        "description": "Atomically creates a new organization, initial independent Member, and binding to an existing active verified phone factor. Does not grant application roles.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationEnrollment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original accepted enrollment receipt, including exact replays.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentReceipt"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/enrollment": {
      "get": {
        "operationId": "getOrganizationEnrollment",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original accepted enrollment receipt, including exact replays.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentReceipt"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/dingtalk-application": {
      "get": {
        "operationId": "getDingTalkApplication",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current DingTalk application metadata; never includes credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DingTalkApplication"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "operationId": "configureDingTalkApplication",
        "description": "Verifies DingTalk authorization and configures or rotates organization application credentials with an expected revision. Does not enable interactive DingTalk login in this increment.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrganizationID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DingTalkApplicationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current DingTalk application metadata; never includes credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DingTalkApplication"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "managementBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random installation management credential. OIDC tokens and client secrets are not accepted."
      }
    },
    "responses": {
      "Error": {
        "description": "400 invalid request; 401 missing or invalid management credential; 403 browser access denied or ineligible factor; 404 record not found; 409 identifier or binding conflict; 415 JSON required; 422 candidate Member identifier collision; 500 internal error; 503 provider verification unavailable. Unknown routes and unsupported methods may use ordinary HTTP errors.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "OrganizationID": {
        "type": "string",
        "pattern": "^org_[0-9bcdfghjkmnpqrstvwxz]{27}$"
      },
      "MemberID": {
        "type": "string",
        "pattern": "^mbr_[0-9bcdfghjkmnpqrstvwxz]{27}$"
      },
      "FactorID": {
        "type": "string",
        "pattern": "^af_[0-9bcdfghjkmnpqrstvwxz]{27}$"
      },
      "Organization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OrganizationID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MemberID"
          },
          "organizationId": {
            "$ref": "#/components/schemas/OrganizationID"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked"
            ]
          },
          "blockSources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "manual",
                "externalDeparture"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "displayName",
          "status",
          "blockSources",
          "createdAt",
          "updatedAt"
        ]
      },
      "Factor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/FactorID"
          },
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "dingtalk"
            ]
          },
          "namespace": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "namespace",
          "subject",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "memberId": {
            "$ref": "#/components/schemas/MemberID"
          },
          "organizationId": {
            "$ref": "#/components/schemas/OrganizationID"
          },
          "authenticationFactorId": {
            "$ref": "#/components/schemas/FactorID"
          },
          "factorType": {
            "type": "string",
            "enum": [
              "phone",
              "dingtalk"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "memberId",
          "organizationId",
          "authenticationFactorId",
          "factorType",
          "status",
          "createdAt",
          "revokedAt"
        ]
      },
      "Eligibility": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eligible": {
            "type": "boolean"
          },
          "bindingId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "eligible"
        ]
      },
      "CreateOrganization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OrganizationID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateOrganization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          }
        },
        "required": [],
        "minProperties": 1
      },
      "CreateMember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MemberID"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "displayName"
        ]
      },
      "UpdateMember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "manualBlocked": {
            "type": "boolean"
          }
        },
        "required": [],
        "minProperties": 1
      },
      "BindFactor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authenticationFactorId": {
            "$ref": "#/components/schemas/FactorID"
          }
        },
        "required": [
          "authenticationFactorId"
        ]
      },
      "EligibilityRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organizationId": {
            "$ref": "#/components/schemas/OrganizationID"
          },
          "memberId": {
            "$ref": "#/components/schemas/MemberID"
          },
          "authenticationFactorId": {
            "$ref": "#/components/schemas/FactorID"
          },
          "authenticationFactorType": {
            "type": "string",
            "enum": [
              "phone",
              "dingtalk"
            ]
          }
        },
        "required": [
          "organizationId",
          "memberId",
          "authenticationFactorId",
          "authenticationFactorType"
        ]
      },
      "OrganizationPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "nextAfter": {
            "$ref": "#/components/schemas/OrganizationID"
          }
        },
        "required": [
          "items"
        ]
      },
      "MemberPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "nextAfter": {
            "$ref": "#/components/schemas/MemberID"
          }
        },
        "required": [
          "items"
        ]
      },
      "BindingList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Binding"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
